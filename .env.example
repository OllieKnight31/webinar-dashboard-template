# Webinar Dashboard: every setting.
#
# You rarely edit this by hand:
#   node scripts/configure.js …   writes client.env and generates the four secrets
#   node scripts/push-env.js      sends client.env to Vercel
# The owner enters everything in section 2 onwards in the app (Setup and Settings); what they
# save there is encrypted and wins over these.

# 1. Must be environment variables (configure.js creates the first three)
APP_SECRET=""                # encrypts everything saved and signs the sign-in cookie. Never change it once in use
BUILD_KEY=""                 # Bearer key for the skill's build scripts (intake and build board only)
CRON_SECRET=""               # Vercel sends it with the hourly update

# Optional sign-in. Leave BOTH blank and the app has no login at all (anyone with the address
# can open it). Set ONE of them to protect it:
ACCESS_PASSWORD=""           # one shared password, typed on the sign-in screen
SETUP_CODE=""                # or: a one-time code; the owner types it on the first visit and chooses their own password
# KV_REST_API_URL=""         # added by Vercel when Upstash Redis is connected (Storage, Upstash, Redis)
# KV_REST_API_TOKEN=""       # locally, .data/ is used instead

# 2. Business
BRAND_NAME="Your business"
TIMEZONE="UTC"               # Region/City, for example Europe/London
CURRENCY_SYMBOL="$"

# 3. Webinar platform
WEBINAR_PROVIDER="none"      # webinarjam | ewebinar | aevent | none
WEBINARJAM_PRODUCT="webinarjam"   # webinarjam (live) | everwebinar (pre-recorded)
WEBINARJAM_API_KEY=""
EWEBINAR_API_KEY=""          # ew_api_…, with the Registrants permission
AEVENT_TOKEN=""              # a logged-in user's session token; it stops working when they log in again
WEBINAR_API_KEY=""           # for a platform added later
WEBINAR_IDS=''               # '["123"]' the webinars that count; blank = all
WEBINAR_PITCH_MINUTE=""      # minute the offer starts (platforms that report minutes watched)
WEBINAR_PITCH_PERCENT=""     # percent where the offer starts (platforms that report percent watched)
WEBINAR_CONFIRMATION_URL=""  # where a sign-up is sent afterwards
WEBINAR_ALLOWED_ORIGINS=""   # "https://go.example.com" only these sites may send sign-ups; blank = any

# 4. Contacts, calendar, payments, ads
CRM_PROVIDER="none"          # ghl | close | none
GHL_API_KEY=""
GHL_LOCATION_ID=""
GHL_PIPELINE_ID=""           # optional: also add each sign-up to this pipeline
CLOSE_API_KEY=""
CRM_FIELDS_JSON=''           # optional: '{"utm_source":"<custom field id>"}' to copy UTM values onto the contact
CALENDLY_TOKEN=""
CALENDLY_BOOKED_TYPES=''     # '["Strategy call"]' the meetings that are sales calls; blank = all
PAYMENTS_PROVIDER=""         # stripe | whop | commas | paypal | ghl | kajabi | lemonsqueezy | paddle | none (normally chosen in Setup step 4)
STRIPE_SECRET_KEY=""         # rk_live_… (read only)
ADS_PROVIDER="none"          # meta | none
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""        # act_1234567890
META_CAMPAIGN_FILTER=""      # only campaigns whose name contains this

# 5. Other
TARGETS_JSON=''              # '{"show_up_rate":0.4}' decimals; defaults: sign-up 0.3, show-up 0.4, stayed 0.6, booking 0.1, call show 0.7, close 0.25
EVENT_INGEST_SECRET=""       # lets other tools push updates to POST /api?source=event
ALERTS_WEBHOOK=""            # optional Slack or Discord incoming webhook address for "something needs attention"
SYNC="on"                    # "off" stops the hourly update
SYNC_LOOKBACK_DAYS="120"     # how far back each update reads
QUESTIONNAIRE_DOCS_JSON=''   # optional: '{"offer":"<google doc id>"}' shows "Open in Google Docs" on that questionnaire

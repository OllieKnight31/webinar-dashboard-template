{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/setup",
      "destination": "/index.html"
    },
    {
      "source": "/results",
      "destination": "/results.html"
    },
    {
      "source": "/settings",
      "destination": "/settings.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    }
  ]
}
